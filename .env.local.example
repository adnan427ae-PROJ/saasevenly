# Copy this file to ".env.local" and fill in what you need.
#
#   cp .env.local.example .env.local
#
# ONLY DATABASE_URL is required. Everything else is optional — you only need the
# keys for the ONE payment gateway you select in the dashboard's "Payments" tab.
# Stripe is the default and the most tested.
#
# After editing .env.local, restart `npm run dev` so Next.js reloads the keys.
# ---------------------------------------------------------------------------

# ===== DATABASE (Postgres) — REQUIRED =====
# Where all your data lives (accounts, settings, plans, sessions, domains).
# On Vercel the filesystem is temporary, so data MUST live in Postgres.
#   1. Create a free project at https://supabase.com (or Neon, Railway, …)
#   2. Open the SQL Editor, paste the contents of schema.sql, and Run it once.
#   3. Project Settings > Database > Connection string > "Transaction" pooler
#      (port 6543). Copy it and paste below. Replace [YOUR-PASSWORD] with your
#      database password. Keep ?pgbouncer=true if the string includes it.
# Example:
#   postgresql://postgres.abcdef:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# On Vercel: add this same variable under Project > Settings > Environment Variables.
DATABASE_URL=

# ===== ADMIN ACCESS (optional) =====
# Comma-separated emails that get the private /admin panel (signup analytics).
# Sign up normally with one of these emails and you'll see an "Admin" button in
# your dashboard. Not stored in the DB — only whoever controls this env var can
# grant admin.
ADMIN_EMAILS=

# ===== PUBLIC DEMO MODE (optional) =====
# Set to 1 to run a showcase instance: the landing page, live pricing demo and
# install guide stay public, but signup and login are closed (visitors are shown
# how to deploy their own copy instead). This is what saasevenly.vercel.app runs.
# Leave it UNSET for a normal instance where you can create an account.
NEXT_PUBLIC_DEMO_MODE=

# Override the donate link if you fork this project.
# NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/yourname

# ===== STRIPE (default, fully tested) =====
# Your own Stripe account — this charges YOUR customers, and the money lands in
# YOUR account. Nothing passes through anyone else.
# Dashboard > Developers > API keys, with "Test mode" ON:
#   https://dashboard.stripe.com/test/apikeys
# Secret key starts with sk_test_ (click "Reveal"). Publishable starts pk_test_.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== PAYPAL (optional) =====
# Create a Sandbox app and copy its Client ID + Secret:
#   https://developer.paypal.com/dashboard/applications/sandbox
# Leave PAYPAL_ENV as "sandbox" for testing; set it to "live" when you go live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ===== RAZORPAY (optional, great for India/South Asia) =====
# Dashboard > Account & Settings > API Keys (use Test Mode keys):
#   https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== DODO PAYMENTS (optional, Merchant of Record — handles your global tax) =====
# 1. Get an API key:  https://app.dodopayments.com/developer/api-keys
# 2. Create a product with "Pay What You Want" ENABLED, copy its product id
#    (looks like prod_xxx). This lets saasevenly pass YOUR localized PPP price.
# 3. Leave DODO_ENV as "test" for now; set it to "live" when you go live.
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_ENV=test
