# Copy this file to ".env.local" and paste in the keys for the gateway(s) you
# want to use. You only need the keys for the ONE gateway you select in the
# dashboard's "Payments" tab. Stripe is the default and the most tested.
#
#   cp .env.local.example .env.local
#
# After editing .env.local, restart `npm run dev` so Next.js reloads the keys.
# ---------------------------------------------------------------------------

# ===== DATABASE (Supabase Postgres) — REQUIRED =====
# Where all your data lives (founders, settings, plans, sessions, domains). On
# Vercel the filesystem is temporary, so data MUST live in Supabase, not a file.
#   1. Create a free project at https://supabase.com
#   2. Open the SQL Editor, paste the contents of schema.sql, and Run it once.
#   3. Project Settings > Database > Connection string > "Transaction" pooler
#      (port 6543). Copy it and paste below. Replace [YOUR-PASSWORD] with your
#      database password. Keep ?pgbouncer=true if the string includes it.
# Example:
#   postgresql://postgres.abcdef:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# On Vercel: add this same variable under Project > Settings > Environment Variables.
DATABASE_URL=

# ===== ADMIN ACCESS =====
# Comma-separated emails that get the private /admin panel (analytics + invite
# codes). Sign up like a normal founder with one of these emails and you'll see
# an "Admin" button in your dashboard. Not stored in the DB — only whoever
# controls this env var can grant admin.
ADMIN_EMAILS=

# ===== SAASEVENLY'S OWN BILLING (founders paying for saasevenly) =====
# This is YOUR platform Stripe account — the one that collects the $9/mo /
# $90/yr saasevenly subscriptions. Separate from the founder gateway keys
# below, which charge the founder's customers.
#   1. Secret key: https://dashboard.stripe.com/test/apikeys
#   2. Webhook: Dashboard > Developers > Webhooks > Add endpoint
#        URL: https://YOUR-DOMAIN.com/api/billing/webhook
#        Events: checkout.session.completed, customer.subscription.updated,
#                customer.subscription.deleted
#      For local testing: stripe listen --forward-to localhost:3000/api/billing/webhook
SAASEVENLY_STRIPE_SECRET_KEY=
SAASEVENLY_STRIPE_WEBHOOK_SECRET=

# ===== STRIPE (default, fully tested) =====
# Dashboard > Developers > API keys, with "Test mode" ON:
#   https://dashboard.stripe.com/test/apikeys
# Secret key starts with sk_test_ (click "Reveal"). Publishable starts pk_test_.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== PAYPAL (optional) =====
# Create a Sandbox app and copy its Client ID + Secret:
#   https://developer.paypal.com/dashboard/applications/sandbox
# Leave PAYPAL_ENV as "sandbox" for testing; set it to "live" when you go live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ===== RAZORPAY (optional, great for India/South Asia) =====
# Dashboard > Account & Settings > API Keys (use Test Mode keys):
#   https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== DODO PAYMENTS (optional, Merchant of Record — handles your global tax) =====
# 1. Get an API key:  https://app.dodopayments.com/developer/api-keys
# 2. Create a product with "Pay What You Want" ENABLED, copy its product id
#    (looks like prod_xxx). This lets saasevenly pass YOUR localized PPP price.
# 3. Leave DODO_ENV as "test" for now; set it to "live" when you go live.
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_ENV=test
